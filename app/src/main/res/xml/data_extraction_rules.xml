<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) backup/transfer rules.
  Mirrors backup_rules.xml: only the local Room database (clients/sales) is
  included in cloud backup and device-to-device transfer.
  See docs/adr/0004-explicit-backup-and-network-security.md.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
